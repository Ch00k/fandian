# Copy to .env and fill in. Never commit .env.
#
# Every setting carries the FANDIAN_ prefix; the same name in the environment overrides .env for
# one run.

# Your `claude setup-token` token: the agent runs on the Claude plan of the account behind it,
# which must have paid overage switched off.
FANDIAN_CLAUDE_TOKEN=
# Optional: the agent's model, over the `model` in your ~/.claude/settings.json.
# FANDIAN_CLAUDE_MODEL=

# One fine-grained GitHub token per tested repository (github_pat_...), named after the repository
# in upper case with every other character _: only that repository, with Issues read and write.
FANDIAN_GITHUB_TOKEN_OWNER_REPO=
